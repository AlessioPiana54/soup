{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {},
    "sdk": {
      "entry": [
        "scripts/*.mjs",
        "test/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/*.mjs",
        "test/**/*.ts"
      ]
    },
    "*/app": {
      "entry": [
        "src/index.ts",
        "test/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    },
    "_template/app": {
      "entry": [
        "src/index.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    }
  }
}
